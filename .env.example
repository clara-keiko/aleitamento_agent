# Copie para .env e preencha. Nunca versione o .env preenchido.

# --- Canal: "meta" (Cloud API oficial) ou "twilio" ---
WHATSAPP_PROVIDER=meta

# --- Meta WhatsApp Cloud API ---
# Você define este valor e repete no painel da Meta ao assinar o webhook.
VERIFY_TOKEN=
# Token de acesso do app (temporário no teste, permanente via System User).
WHATSAPP_TOKEN=
# ID do número no painel da Meta (não é o telefone).
PHONE_NUMBER_ID=
# App Secret, em Configurações > Básico. Assina o webhook; obrigatório.
APP_SECRET=
GRAPH_VERSION=v25.0

# --- Twilio (alternativa de número; ver docs/OPERACAO.md) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL pública do serviço. A Twilio assina a URL; atrás de proxy isso é preciso.
PUBLIC_BASE_URL=

# --- OpenAI ---
OPENAI_API_KEY=
# Gerado por `python ingest_openai_kb.py`.
VECTOR_STORE_ID=
# gpt-4o-mini é de 2024. Compare com gpt-5-mini antes do piloto:
#   python evals/run_eval.py --live --model gpt-5-mini
# Análise em docs/OPERACAO.md §6.
OPENAI_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Segundos até desistir de uma chamada (o default do SDK é 600 s).
OPENAI_TIMEOUT_SECONDS=45
# Trechos recuperados por pergunta: maior alavanca de custo e latência.
MAX_RETRIEVAL_RESULTS=8
MAX_OUTPUT_TOKENS=500

# --- Protótipo web ---
# Serve o chat em /chat, com a mesma lógica do WhatsApp. Permite validar o
# conteúdo com a consultora antes de existir número.
ENABLE_WEB=true
# Sem código, quem tiver o link gasta sua cota da OpenAI. Defina antes de
# compartilhar: openssl rand -hex 8
WEB_ACCESS_CODE=

# --- Comportamento ---
ENABLE_AUDIO=true
HISTORY_TURNS=6
HISTORY_TTL_SECONDS=1800
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=600
MAX_AUDIO_SECONDS=120
# Só deixe false em teste local. Em produção mantenha true.
REQUIRE_SIGNATURE=true
LOG_LEVEL=INFO
# Chave para pseudonimizar telefones no log. Gere com: openssl rand -hex 32
PSEUDONYM_KEY=
