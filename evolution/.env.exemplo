# Copie para .env antes de subir o compose.
#
# Esta chave é a senha do serviço inteiro: quem a tiver manda mensagem pelo
# seu número. Gere uma forte, por exemplo:
#
#   python3 -c "import secrets; print(secrets.token_hex(24))"
#
# O mesmo valor vai para EVOLUTION_API_KEY no agente — ele usa a chave para
# enviar e para conferir os webhooks que chegam.

AUTHENTICATION_API_KEY=
