# Copie para .env antes de subir o compose:  cp .env.exemplo .env
#
# O arquivo .env é ignorado pelo git — não vai para o repositório.

# Senha do serviço inteiro: quem tiver esta chave manda mensagem pelo seu
# número. Gere uma forte:
#
#   python3 -c "import secrets; print(secrets.token_hex(24))"
#
# O agente usa o mesmo valor para enviar e para conferir os webhooks que
# chegam, por isso ele aparece uma vez só aqui.
AUTHENTICATION_API_KEY=

# Nome da instância na Evolution. Qualquer um serve; só precisa bater com o
# que você usar no scripts/evolution_setup.py.
EVOLUTION_INSTANCE=lactai

# O cérebro do agente. Sem estes dois ele sobe, mas recusa responder.
OPENAI_API_KEY=
VECTOR_STORE_ID=vs_6a66c51e4c548191b85162a47c425dd4

# Só responde a estes números (separados por vírgula). Preencha SEMPRE que o
# número pareado também receber conversas de verdade — o seu WhatsApp pessoal,
# por exemplo. Sem isso, o agente responde à família e aos clientes também.
# Com ou sem o 9 do celular, com ou sem +55: tanto faz.
ALLOWED_SENDERS=
